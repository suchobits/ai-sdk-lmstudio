{
  "name": "ai-sdk-lmstudio",
  "version": "0.1.0",
  "description": "LM Studio provider for Vercel AI SDK with streaming token tracking",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/ tests/",
    "check": "biome check --write src/ tests/",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/provider-utils": "^4.0.27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.2",
    "ai": "^6.0.176",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "lmstudio",
    "lm-studio",
    "local-llm",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/suchobits/ai-sdk-lmstudio"
  }
}
